# Copy this file to .env.local (git-ignored) and fill in real values once a
# Supabase project exists. Never commit real credentials — .env.local (and
# any .env* other than this example file) is already git-ignored.
#
# Both are safe to expose in client-side code: the anon key is meant to be
# public and is constrained entirely by the Row Level Security policies in
# supabase/migrations/0001_init.sql — it grants no access on its own.
#
# Until these are set, the app runs exactly as it does today: no auth, no
# database, local-only profile in localStorage. See src/lib/supabaseClient.ts.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
